APP_NAME="ZB Idea Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase Postgres. Paste the values exactly as Supabase (or its Vercel integration) gives you; no renaming needed.
# The app uses the first one that is set: DB_URL, then POSTGRES_URL_NON_POOLING, then POSTGRES_URL.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# Or give the parts instead of a URL (POSTGRES_HOST / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DATABASE also work):
DB_CONNECTION=pgsql
# DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR-PROJECT-REF
# DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ideas.zb.co.zw"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (realtime chat and notifications). Generate your own values.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ZB Idea Manager
# Leave empty to allow any email (temporary). Set to zb.co.zw to restrict sign-in to ZB staff.
IDEAS_EMAIL_DOMAIN=
# Demo only: accept any 6 digits instead of the emailed code. Keep false in production.
IDEAS_ACCEPT_ANY_CODE=false
IDEAS_AUTO_PROVISION=true
# TEMPORARY: false = a valid email is enough to sign in (no emailed code). Anyone can then sign in as anyone. Set true once mail works.
IDEAS_REQUIRE_CODE=false
# TEMPORARY: lets anyone pick Employee or Executive at sign-in. Set false once executives are assigned.
IDEAS_ALLOW_ROLE_CHOICE=true

# WhatsApp Cloud API (leave empty to run without WhatsApp; messages are then only logged)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_TPL_APPROVED=idea_approved

# File uploads (images, documents, avatars): "public" = this server's disk, "supabase" = Supabase Storage.
IDEAS_UPLOAD_DISK=public
# Supabase project URL, as given by Supabase (Project Settings > API). Only needed when uploads use Supabase Storage.
SUPABASE_URL=
# Storage > S3 Connection: create an access key, then paste its values here.
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_REGION=us-east-1
# Not used by this app, so you can leave them out of .env: SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET.
